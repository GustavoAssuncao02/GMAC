PORT=3001
GMAC_HOST=127.0.0.1
# Origens sem caminho e sem barra final, separadas por virgula.
ALLOWED_ORIGINS=https://gmacmetalurgica.com.br,https://www.gmacmetalurgica.com.br,http://localhost:5173
# Microsoft 365: STARTTLS obrigatorio na porta 587.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=comercial@gmacmetalurgica.com.br
# Preencha somente no servidor. SMTP AUTH deve estar autorizado na conta.
SMTP_PASS=
MAIL_FROM=comercial@gmacmetalurgica.com.br
# Um proxy local: Filminhos -> GMAC. API vinculada a 127.0.0.1.
TRUST_PROXY_HOPS=1

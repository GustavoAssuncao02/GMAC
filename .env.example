# URL publica HTTPS do GMAC BACKEND, sem /api/quotes.
# Local: http://localhost:3001
VITE_API_URL=

# Site key (publica) do Cloudflare Turnstile, o captcha da pagina /OfertarServico.
# Sem ela a pagina mostra "envio indisponivel" e nao envia. Local: 1x00000000000000000000AA (chave de teste).
VITE_TURNSTILE_SITE_KEY=
